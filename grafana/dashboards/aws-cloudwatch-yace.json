{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 0 },
      "id": 1,
      "title": "AWS EC2 Average CPU Utilization (%)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "avg(aws_ec2_cpuutilization_average{region=~\"$region\", dimension_InstanceId=~\"$instance_id\"}) or avg(aws_ec2_cpuutilization_average{region=~\"$region\"}) or vector(0)",
          "legendFormat": "EC2 CPU Avg",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 75 },
              { "color": "red", "value": 90 }
            ]
          },
          "unit": "percent"
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 0 },
      "id": 2,
      "title": "Monitored EC2 Instance / Metric Count",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "count(aws_ec2_cpuutilization_average{region=~\"$region\", dimension_InstanceId=~\"$instance_id\"}) or count(aws_ec2_cpuutilization_average{region=~\"$region\"}) or vector(0)",
          "legendFormat": "Count",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null }
            ]
          }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 0 },
      "id": 3,
      "title": "YACE CloudWatch Exporter Status",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "up{job=\"yace\"}",
          "legendFormat": "YACE Status",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP (Connected)", "color": "green" } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "id": 4,
      "title": "EC2 Instance CPU Utilization Trend",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "aws_ec2_cpuutilization_average{region=~\"$region\", dimension_InstanceId=~\"$instance_id\"}",
          "legendFormat": "{{dimension_InstanceId}} ({{region}})",
          "refId": "A"
        },
        {
          "expr": "aws_ec2_cpuutilization_average{region=~\"$region\"}",
          "legendFormat": "EC2 Overall Avg ({{region}})",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth" },
          "unit": "percent"
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "id": 5,
      "title": "EC2 Network Traffic (In / Out)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "aws_ec2_network_in_average{region=~\"$region\", dimension_InstanceId=~\"$instance_id\"}",
          "legendFormat": "{{dimension_InstanceId}} Network In",
          "refId": "A"
        },
        {
          "expr": "aws_ec2_network_out_average{region=~\"$region\", dimension_InstanceId=~\"$instance_id\"}",
          "legendFormat": "{{dimension_InstanceId}} Network Out",
          "refId": "B"
        },
        {
          "expr": "aws_ec2_network_in_average{region=~\"$region\"}",
          "legendFormat": "Overall Network In ({{region}})",
          "refId": "C"
        },
        {
          "expr": "aws_ec2_network_out_average{region=~\"$region\"}",
          "legendFormat": "Overall Network Out ({{region}})",
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth" },
          "unit": "bytes"
        }
      }
    }
  ],
  "refresh": "1m",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["aws", "cloudwatch", "yace", "ec2"],
  "templating": {
    "list": [
      {
        "allValue": ".*",
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "hide": 0,
        "includeAll": true,
        "label": "Region",
        "multi": true,
        "name": "region",
        "options": [
          { "selected": true, "text": "All", "value": "$__all" },
          { "selected": false, "text": "eu-north-1", "value": "eu-north-1" },
          { "selected": false, "text": "ap-south-1", "value": "ap-south-1" },
          { "selected": false, "text": "us-east-1", "value": "us-east-1" },
          { "selected": false, "text": "us-west-2", "value": "us-west-2" }
        ],
        "query": "eu-north-1, ap-south-1, us-east-1, us-west-2",
        "skipUrlSync": false,
        "type": "custom"
      },
      {
        "allValue": ".*",
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "hide": 0,
        "includeAll": true,
        "label": "Instance ID",
        "multi": true,
        "name": "instance_id",
        "options": [
          { "selected": true, "text": "All", "value": "$__all" },
          { "selected": false, "text": "i-0123456789abcdef0", "value": "i-0123456789abcdef0" },
          { "selected": false, "text": "i-0fe4596123456789a", "value": "i-0fe4596123456789a" },
          { "selected": false, "text": "i-0abcd1234ef567890", "value": "i-0abcd1234ef567890" }
        ],
        "query": "i-0123456789abcdef0, i-0fe4596123456789a, i-0abcd1234ef567890",
        "skipUrlSync": false,
        "type": "custom"
      }
    ]
  },
  "time": { "from": "now-3h", "to": "now" },
  "timepicker": { "refresh_intervals": ["1m", "5m", "15m"] },
  "timezone": "browser",
  "title": "AWS CloudWatch Metrics (YACE)",
  "uid": "aws-cloudwatch-yace"
}
